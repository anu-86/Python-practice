'''Practice Questions

Q1
Create a function countdown(n).
Print numbers from 5 to 1 using recursion.
Call the function with 5.'''

def countdown(n):
	if n ==0:
		return
	print(n)
	countdown(n-1)
countdown(5)

'''Q2
Create a function countup(n).
Print numbers from 1 to 5 using recursion.
Call the function with 1.'''

def countup(n):
	if n == 6:
		return
	print(n)
	countup(n+1)
countup(1)

'''Q3
Create a function display(n).
Print numbers from 3 to 1 using recursion.
Call the function with 3.'''

def display(n):
	if n == 0:
		return
	print(n)
	display(n-1)
display(3)

