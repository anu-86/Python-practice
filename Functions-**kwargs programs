'''Practice Questions

Q1
Create a function student(**kwargs).
Call it with:
name="Anu"
age=20
Print the entire dictionary.'''

def student(**kwargs):
print(kwargs)
student(name='Anu',age=20)

'''Q2
Create a function employee(**kwargs).
Call it with:
