'''Q4
Create a function book(**kwargs).
Call it with:
title="Python"
author="Guido"
Use a for loop with .items() to print both the key and value.'''

def book(**kwargs):
for key,value in kwargs.items():
print(key ,':' ,value)
book(title='Python',author='Guido')

