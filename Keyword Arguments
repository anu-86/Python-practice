'''Practice Questions
Q1
Create a function employee(name, salary).
Call it using keyword arguments:
name = "Anu"
salary = 30000'''

def employee(name,salary):
	print(name)
	print(salary)
employee(name='Anu',salary=30000)

'''Q2
Create a function book(title, author).
Call it using keyword arguments in reverse order.'''

def book(title, author):
    print(title)
    print(author)

book(author="John Lasseter", title="Toy Story")

